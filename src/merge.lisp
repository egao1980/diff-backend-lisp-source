(in-package #:diff-backend-lisp-source)

;;; Three-way merge and rebase (brief: "Three-way merge", "Rebase"). The merge is
;;; form level and lives in the %THREE-WAY hook: the tree engine calls it directly
;;; for each file both sides modified. THREE-WAY-DIFF wraps it with the
;;; USE-TEXT-DIFF / USE-VALUE restarts; REBASE-DIFF goes through diff-protocol's
;;; %REBASE-BY-MERGE (conflicts resolved to ONTO).

(defun %touches (x)
  (if (%e-from x) (list (%e-key x) (%e-from x)) (list (%e-key x))))

(defun %after-text (x)
  (and (%e-after x) (%u-text (%e-after x))))

(defun %twin-p (o x)
  (and (eq (%e-kind o) (%e-kind x))
       (string= (%e-key o) (%e-key x))
       (equal (%e-from o) (%e-from x))
       (equal (%after-text o) (%after-text x))
       (or (not (member (%e-kind o) '(:add :move)))
           (equal (%e-a-anchor o) (%e-a-anchor x)))))

(defun %pure-reorder-p (x)
  (and (eq (%e-kind x) :move)
       (string= (%e-from x) (%e-key x))
       (string= (%u-text (%e-before x)) (%u-text (%e-after x)))))

(defun %compatible-p (o x)
  (or (and (%pure-reorder-p o) (eq (%e-kind x) :modify))
      (and (%pure-reorder-p x) (eq (%e-kind o) :modify))))

(defun %keys< (x y)
  "Element by element with STRING<; a proper prefix first."
  (loop
    (cond ((null x) (return (not (null y))))
          ((null y) (return nil))
          ((string< (first x) (first y)) (return t))
          ((string< (first y) (first x)) (return nil))
          (t (pop x) (pop y)))))

(defun %merge-entries (os ts resolve)
  "→ (values kept-ours kept-theirs conflicts)."
  (let ((ost (make-hash-table :test #'eq))
        (tst (make-hash-table :test #'eq))
        (conflicts '()))
    (dolist (o os)
      (dolist (x ts)
        (when (intersection (%touches o) (%touches x) :test #'string=)
          (cond ((%twin-p o x)
                 (unless (gethash o ost) (setf (gethash o ost) :twin))
                 (unless (gethash x tst) (setf (gethash x tst) :twin)))
                ((%compatible-p o x))
                (t
                 (setf (gethash o ost) :conflict (gethash x tst) :conflict)
                 (push (diff-protocol::%conflict (%entry-change o :content)
                                                 (%entry-change x :content))
                       conflicts))))))
    (values (remove-if (lambda (o) (eq (gethash o ost) :conflict)) os)
            (if (eq resolve :theirs)
                ts
                (remove-if (lambda (x) (eq (gethash x tst) :conflict)) ts))
            (nreverse conflicts))))

(defun %merge-text (sbase sours stheirs kept-o kept-t)
  "The merged source from the kept entries of both sides."
  (let ((removed (make-hash-table :test #'equal))
        (pos-o (make-hash-table :test #'equal))
        (pos-t (make-hash-table :test #'equal))
        (modified (make-hash-table :test #'equal))
        (placed (make-hash-table :test #'equal))
        (trailer nil))
    (flet ((note (x pos)
             (case (%e-kind x)
               (:remove (setf (gethash (%e-key x) removed) t))
               (:modify (setf (gethash (%e-key x) modified) (%after-text x)))
               ((:add :move)
                (setf (gethash (%e-key x) pos) t)
                (unless (gethash (%e-key x) placed)
                  (setf (gethash (%e-key x) placed) (%after-text x)))
                (when (and (%e-from x) (string/= (%e-from x) (%e-key x)))
                  (setf (gethash (%e-from x) removed) t))
                (when (and (eq (%e-kind x) :add) (%u-trailer-p (%e-after x)) (null trailer))
                  (setf trailer (%e-key x)))))))
      (dolist (x kept-o) (note x pos-o))
      (dolist (x kept-t) (note x pos-t)))
    (labels ((text (k)
               (or (gethash k modified)
                   (gethash k placed)
                   (%u-text (%side-unit sbase k))))
             (positioned-p (k) (or (gethash k pos-o) (gethash k pos-t))))
      (let* ((base-trailer (find-if #'%u-trailer-p (%s-units sbase)))
             (trailer (cond ((and base-trailer (not (gethash (%u-key base-trailer) removed)))
                             (%u-key base-trailer))
                            (t trailer)))
             (skeleton (loop for u across (%s-units sbase)
                             for k = (%u-key u)
                             unless (or (%u-trailer-p u) (gethash k removed) (positioned-p k))
                               collect k))
             (in-skeleton (let ((h (make-hash-table :test #'equal)))
                            (dolist (k skeleton h) (setf (gethash k h) t)))))
        (flet ((runs (side pos)
                 ;; place (skeleton key or NIL) → keys, in the side's own order
                 (let ((runs (make-hash-table :test #'equal))
                       (last nil))
                   (loop for u across (%s-units side)
                         for k = (%u-key u)
                         do (cond ((%u-trailer-p u))
                                  ((gethash k in-skeleton) (setf last k))
                                  ((gethash k pos)
                                   (setf (gethash last runs)
                                         (append (gethash last runs) (list k))))))
                   runs)))
          (let ((runs-o (runs sours pos-o))
                (runs-t (runs stheirs pos-t))
                (emitted (make-hash-table :test #'equal)))
            (with-output-to-string (s)
              (flet ((emit (k)
                       (unless (gethash k emitted)
                         (setf (gethash k emitted) t)
                         (write-string (text k) s))))
                (dolist (place (cons nil skeleton))
                  (when place (emit place))
                  (let ((ro (gethash place runs-o))
                        (rt (gethash place runs-t)))
                    (dolist (run (if (and ro rt (%keys< rt ro)) (list rt ro) (list ro rt)))
                      (mapc #'emit run))))
                (when trailer
                  (emit trailer))))))))))

(defmethod diff-protocol::%three-way ((e lisp-source-diff-engine) base ours theirs resolve)
  (let ((sb (%read-side e base)))
    (multiple-value-bind (so st) (%rekey-both sb (%read-side e ours) (%read-side e theirs))
     (multiple-value-bind (kept-o kept-t conflicts)
        (%merge-entries (%align e sb so) (%align e sb st) resolve)
      (let ((merged (%merge-text sb so st kept-o kept-t)))
        (values (%diff e base merged :changes) conflicts))))))

(defmethod diff-protocol:three-way-diff ((e lisp-source-diff-engine) base ours theirs)
  (restart-case (diff-protocol::%three-way e base ours theirs :base)
    (use-text-diff ()
      :report "Merge the three states with the :text engine (diff3) instead."
      (diff-protocol:three-way-diff (diff-protocol:find-diff-engine :text) base ours theirs))
    (use-value (value)
      :report "Return a given value as the merge result."
      :interactive (lambda ()
                     (format *query-io* "Value (evaluated): ")
                     (force-output *query-io*)
                     (list (eval (read *query-io*))))
      value)))

(defmethod diff-protocol::%rebase ((e lisp-source-diff-engine) d onto base)
  (diff-protocol::%rebase-by-merge e d onto base))
